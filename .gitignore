# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp

# --- Environment files (templates .env.example ARE tracked) ---
.env
backend/.env
frontend/.env
*.env.local

# --- Dependencies / build output (backstop; each app also has its own .gitignore) ---
backend/vendor/
frontend/node_modules/
frontend/dist/
node_modules/

# --- Laravel runtime ---
backend/storage/*.key
backend/database/*.sqlite
